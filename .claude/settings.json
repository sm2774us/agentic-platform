{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "./scripts/hooks/guard-sensitive-commands.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(ruff check*)",
      "Bash(mypy*)",
      "Bash(make *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm -rf*)"
    ]
  }
}
